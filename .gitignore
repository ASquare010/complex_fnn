# Python, environments and local caches
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.cache/
.env
.env.*
/data/

# Local raw evidence stays on disk; publish compact records and reproducible source.
/results/**
!/results/**/
!/results/**/*.py
!/results/**/*.md
!/results/**/result.json
!/results/**/protocol.json
!/results/**/metrics.json
!/results/**/summary.json
!/results/**/config.json
!/results/**/data_manifest.json
!/results/**/before.json
!/results/**/*process*.json
!/results/**/coordinator_status.json
!/results/**/selections/*.json
!/results/verification/*.json
!/results/**/*.png
!/results/**/*.svg
!/results/**/*.csv
!/results/**/source/**/*.json

# Never stage data, tensors, allocator captures or repeated source bundles.
*.pt
*.pth
*.safetensors
*.npy
*.npz
*.pickle
/results/**/*.zip
/results/**/*.jsonl
/results/**/*.log
/results/reproductions/
/results/**/__pycache__/

# Dense sampled curve/spectrum grids: reports and plots are retained; raw grids stay local.
/results/activation_shapes_v1/**/result.json
/results/affine_activation_shapes_v1/**/result.json
/results/conditioning_scale384_v1/result.json
/results/joint_conditioning_scale384_v1/result.json

# Known damaged H079 payload: keep its inventory hash and failure report, not invalid JSON.
/results/blast_operator_v1/result.json

# H090: retain PNG figures publicly; identical vector exports remain local.
/results/neuron_geometry_recovery_v1/plots/*.svg
!/results/neuron_geometry_recovery_v1/qualification_preservation.json

# H094: all-rate CSV includes selected flags; keep compact compressed public tables.
# Detailed selections and figures remain local and are indexed, not deleted.
/results/input_basis_fit_v1/selections/
/results/input_basis_fit_v1/metrics.csv
!/results/input_basis_fit_v1/metrics.csv.gz
/results/input_basis_fit_v1/plots/

# H092-H095: preserve repetitive frozen metadata losslessly in gzip form.
/results/input_basis_lift_v1/before.json
!/results/input_basis_lift_v1/before.json.gz
/results/input_basis_lift_v1/protocol.json
!/results/input_basis_lift_v1/protocol.json.gz
/results/input_basis_recovery_v1/before.json
!/results/input_basis_recovery_v1/before.json.gz
/results/input_basis_recovery_v1/protocol.json
!/results/input_basis_recovery_v1/protocol.json.gz
/results/input_basis_fit_v1/before.json
!/results/input_basis_fit_v1/before.json.gz
/results/input_basis_fit_v1/protocol.json
!/results/input_basis_fit_v1/protocol.json.gz
/results/input_basis_fold_v1/before.json
!/results/input_basis_fold_v1/before.json.gz
/results/input_basis_fold_v1/protocol.json
!/results/input_basis_fold_v1/protocol.json.gz
/results/input_basis_fit_v1/artifact_inventory.csv
/results/input_basis_fold_v1/result.json
!/results/input_basis_fold_v1/result.json.gz

# Final compact exports retain the exact full audit and original DLL failure.
/results/input_basis_fit_v1/result.json
!/results/input_basis_fit_v1/result.json.gz
/results/input_basis_lift_v1/coordinator_status.json
!/results/input_basis_lift_v1/coordinator_status.json.gz

# Preserve H090's full repeated endpoint record losslessly; plain copy stays local.
/results/neuron_geometry_recovery_v1/result.json
!/results/neuron_geometry_recovery_v1/result.json.gz

# H099: retain all endpoints/diagnostics losslessly; redundant selections stay local.
/results/nonlinear_residual_v1/selections/
/results/nonlinear_residual_v1/metrics.csv
!/results/nonlinear_residual_v1/metrics.csv.gz
!/results/nonlinear_residual_v1/diagnostics.json.gz

# Historical inventory is losslessly packed; plain local copy remains unchanged.
/research/evidence/local_artifacts.csv
